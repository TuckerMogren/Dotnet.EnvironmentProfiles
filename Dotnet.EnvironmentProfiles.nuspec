<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Dotnet.EnvironmentProfiles</id>
    <version>1.0.0</version>
    <authors>Tucker Mogren</authors>
    <description>Deterministic environment profile mapping for .NET applications.</description>
    <releaseNotes>Initial release with environment profiles, resolver, defaults, and DI extensions.</releaseNotes>
    <license type="expression">MIT</license>
    <projectUrl>https://tuckermogren.com/projects/DotnetEnvironmentProfiles</projectUrl>
    <repository type="website">https://github.com/TuckerMogren/Dotnet.EnvironmentProfiles</repository>
    <copyright>Copyright 2025 Tucker Mogren</copyright>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.0" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="10.0.0" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="CHANGELOG.md" target="" />
  </files>
</package>
